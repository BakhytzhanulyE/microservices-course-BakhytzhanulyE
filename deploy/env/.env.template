# -----------------------------------------------------------
# ЕДИНЫЙ ФАЙЛ КОНФИГУРАЦИИ ВСЕЙ СИСТЕМЫ
# -----------------------------------------------------------
# Правим только этот файл. Всё остальное раскладывается по
# deploy/compose/<сервис>/.env командой `task env:generate`.
#
# Значения хостов здесь — для запуска сервиса с локальной машины
# (`go run ./cmd/...`). В docker-compose имена контейнеров
# подставляются поверх, через секцию environment.
# -----------------------------------------------------------

# -----------------------------------------------------------
# CORE — общая инфраструктура
# -----------------------------------------------------------
CORE_KAFKA_EXTERNAL_PORT=9092
CORE_KAFKA_INTERNAL_PORT=29092
CORE_KAFKA_CONTROLLER_PORT=29093
CORE_KAFKA_UI_PORT=8090

CORE_JAEGER_UI_PORT=16686
CORE_JAEGER_OTLP_PORT=4317
CORE_PROMETHEUS_PORT=9091
CORE_GRAFANA_PORT=3000
CORE_GRAFANA_ADMIN_PASSWORD=admin

# Общие для всех сервисов настройки наблюдаемости
COMMON_LOGGER_LEVEL=info
COMMON_LOGGER_AS_JSON=true
COMMON_KAFKA_BROKERS=localhost:9092
COMMON_OTLP_ENDPOINT=localhost:4317

# Имена топиков — один источник правды для продюсеров и консьюмеров
TOPIC_ORDER_PAID=order.paid
TOPIC_SHIP_ASSEMBLED=ship.assembled

# -----------------------------------------------------------
# INVENTORY — каталог деталей
# -----------------------------------------------------------
INVENTORY_GRPC_HOST=0.0.0.0
INVENTORY_GRPC_PORT=50051
INVENTORY_METRICS_ENABLED=true
INVENTORY_METRICS_PORT=9101

INVENTORY_MONGO_IMAGE_NAME=mongo:7.0.5
INVENTORY_MONGO_EXTERNAL_PORT=27018
INVENTORY_MONGO_HOST=localhost
INVENTORY_MONGO_PORT=27018
INVENTORY_MONGO_DATABASE=inventory
INVENTORY_MONGO_AUTH_DB=admin
INVENTORY_MONGO_INITDB_ROOT_USERNAME=inventory_admin
INVENTORY_MONGO_INITDB_ROOT_PASSWORD=inventory_secret

# -----------------------------------------------------------
# PAYMENT — оплата
# -----------------------------------------------------------
PAYMENT_GRPC_HOST=0.0.0.0
PAYMENT_GRPC_PORT=50052
PAYMENT_METRICS_ENABLED=true
PAYMENT_METRICS_PORT=9102

# -----------------------------------------------------------
# IAM — аутентификация
# -----------------------------------------------------------
IAM_GRPC_HOST=0.0.0.0
IAM_GRPC_PORT=50053
IAM_METRICS_ENABLED=true
IAM_METRICS_PORT=9103

IAM_POSTGRES_IMAGE_NAME=postgres:16.4-alpine
IAM_POSTGRES_EXTERNAL_PORT=5433
IAM_POSTGRES_HOST=localhost
IAM_POSTGRES_PORT=5433
IAM_POSTGRES_DB=iam
IAM_POSTGRES_USER=iam_admin
IAM_POSTGRES_PASSWORD=iam_secret

IAM_REDIS_IMAGE_NAME=redis:7.4-alpine
IAM_REDIS_EXTERNAL_PORT=6379
IAM_REDIS_HOST=localhost
IAM_REDIS_PORT=6379
IAM_REDIS_DB=0

# Ключ подписи JWT. Для продакшена — только из секрет-хранилища.
IAM_JWT_SECRET_KEY=change-me-in-production
IAM_JWT_ACCESS_TTL=15m
IAM_JWT_REFRESH_TTL=720h

# -----------------------------------------------------------
# ORDER — заказы
# -----------------------------------------------------------
ORDER_HTTP_HOST=0.0.0.0
ORDER_HTTP_PORT=8080
ORDER_METRICS_ENABLED=true
ORDER_METRICS_PORT=9104

ORDER_POSTGRES_IMAGE_NAME=postgres:16.4-alpine
ORDER_POSTGRES_EXTERNAL_PORT=5434
ORDER_POSTGRES_HOST=localhost
ORDER_POSTGRES_PORT=5434
ORDER_POSTGRES_DB=orders
ORDER_POSTGRES_USER=order_admin
ORDER_POSTGRES_PASSWORD=order_secret

# Адреса соседей для локального запуска
ORDER_INVENTORY_GRPC_HOST=localhost
ORDER_INVENTORY_GRPC_PORT=50051
ORDER_PAYMENT_GRPC_HOST=localhost
ORDER_PAYMENT_GRPC_PORT=50052

# -----------------------------------------------------------
# ASSEMBLY — сборочный цех
# -----------------------------------------------------------
ASSEMBLY_METRICS_ENABLED=true
ASSEMBLY_METRICS_PORT=9105
ASSEMBLY_ORDER_PAID_CONSUMER_GROUP_ID=assembly-order-paid
ASSEMBLY_BUILD_DURATION=10s

# -----------------------------------------------------------
# NOTIFICATION — уведомления
# -----------------------------------------------------------
NOTIFICATION_METRICS_ENABLED=true
NOTIFICATION_METRICS_PORT=9106
NOTIFICATION_ORDER_PAID_CONSUMER_GROUP_ID=notification-order-paid
NOTIFICATION_SHIP_ASSEMBLED_CONSUMER_GROUP_ID=notification-ship-assembled

# Пустой токен — уведомления пишутся только в лог
NOTIFICATION_TELEGRAM_BOT_TOKEN=
NOTIFICATION_TELEGRAM_CHAT_ID=
